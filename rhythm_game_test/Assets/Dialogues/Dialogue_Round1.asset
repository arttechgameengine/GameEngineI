  m_Script: {fileID: 11500000, guid: fbb4f5274509a3f4d972369981413e90, type: 3}
  m_Name: Dialogue_Round1
  m_EditorClassIdentifier: 
  chapterTitle: "\uC81C 1\uC7A5"
  backgroundSprite: {fileID: 21300000, guid: 550e5cde59e52de4c80f0ea588784074, type: 3}
  leftCharacterDefault: {fileID: -1716309329, guid: 608455c0a88d71e418d0f31070c6c486, type: 3}
  rightCharacterDefault: {fileID: -167612883, guid: 7c87238b716e3f540989622ccfed2efc, type: 3}
  lines:
  - speakerName: "\uC18C\uCC44"
    speakerSprite: {fileID: 0}
    dialogue: "\uC548\uB155! \uB09C \uC18C\uCC44! \uCC98\uC74C \uBD59\uC9C0\uB9CC,
      \uB9DB\uC788\uB294 \uAC78\uB85C \uC2B9\uBD80\uD558\uBA74 \uB418\uB294 \uAC70\uC9C0?"
    isLeftSpeaker: 1
    effectSprites: []
  - speakerName: "\uC0AC\uBBF8"
    speakerSprite: {fileID: 0}
    dialogue: "\uD760. \uBA85\uB791\uD55C \uCC99\uD55C\uB2E4\uACE0 \uC2E4\uB825\uC774
      \uC0DD\uAE30\uB294 \uAC74 \uC544\uB2C8\uAC70\uB4E0.\r\n\uAD11\uB3D9\uC2DD \uB524\uC12C\uC740
      \uC18D\uB3C4\xB7\uAC10\uAC01\xB7\uC190\uB9DB\u2026 \uD558\uB098\uB77C\uB3C4
      \uD750\uD2B8\uB7EC\uC9C0\uBA74 \uD615\uD3B8\uC5C6\uC5B4\uC838."
    isLeftSpeaker: 0
    effectSprites:
    - {fileID: 11400000, guid: 060609ee3a58ae145a5be8a4d5562d3c, type: 2}
    - {fileID: 11400000, guid: 482b8792814131447b6357e3ec70a318, type: 2}
  - speakerName: "\uC18C\uCC44"
    speakerSprite: {fileID: 0}
    dialogue: "\uB9DE\uC544! \uADF8\uB798\uC11C \uB354 \uC7AC\uBC0C\uC5B4. \uC774\uB7F0
      \uAE34\uC7A5\uAC10, \uB098 \uC644\uC804 \uC88B\uC544\uD558\uAC70\uB4E0!"
    isLeftSpeaker: 1
    effectSprites:
    - {fileID: 11400000, guid: 35d33e6c035d2134a8afaf8fb186450f, type: 2}
  - speakerName: "\uC0AC\uBBF8"
    speakerSprite: {fileID: 0}
    dialogue: "\uD765. \uC785\uC740 \uAC00\uBCBC\uC6B4\uB370 \uC190\uC740 \uC5B4\uB5A8\uC9C0
      \uBCF4\uC790\uACE0.\r\n\uB0B4 \uBE44\uD2B8\uB294 \uCD08\uBCF4\uAC00 \uBC84\uD2F8
      \uB9AC\uAC00 \uC5C6\uC73C\uB2C8\uAE4C."
    isLeftSpeaker: 0
    effectSprites:
    - {fileID: 11400000, guid: fd9e6d8e08d96bd48a2dc810e3d68c9f, type: 2}
  - speakerName: "\uC18C\uCC44"
    speakerSprite: {fileID: 0}
    dialogue: "\uB3C4\uBC1C\uD558\uB124~? \uD558\uC9C0\uB9CC \uB098, \uC27D\uAC8C
      \uC548 \uBB34\uB108\uC838. \n\uB524\uC12C\uC740 \uC791\uC544\uB3C4 \uC815\uC131\uC740
      \uAF49 \uCC2C\uB2E4\uACE0! \uB05D\uAE4C\uC9C0 \uB530\uB77C\uAC08\uAC8C."
    isLeftSpeaker: 1
    effectSprites:
    - {fileID: 11400000, guid: 9dd834cb0e9ec4b4a94b40c7ce369e99, type: 2}
  - speakerName: "\uC0AC\uBBF8"
    speakerSprite: {fileID: 0}
    dialogue: "\u2026\uAE30\uC5B4\uCF54 \uB9D0 \uB300\uB2F5\uC744 \uD558\uB124. \uC88B\uC544.\r\n\uB124
      \uBC18\uC8FD\uC774 \uCC22\uC5B4\uC9C0\uB294 \uC18C\uB9AC\uBD80\uD130 \uB4E4\uB824\uC904\uAC8C."
    isLeftSpeaker: 0
    effectSprites:
    - {fileID: 11400000, guid: 72986dd3404e1b2489f5bc566bfc41a0, type: 2}
  - speakerName: "\uC18C\uCC44"
    speakerSprite: {fileID: 0}
    dialogue: "\uADF8\uB7FC, \uB204\uAC00 \uB354 \uB9DB\uC788\uACE0 \uB9AC\uB4EC
      \uC88B\uC740 \uB524\uC12C\uC744 \uB9CC\uB4DC\uB098 \uBCFC\uAE4C?"
    isLeftSpeaker: 1
    effectSprites:
    - {fileID: 11400000, guid: e9ec13dd2c5b3be4fb1495d399d9afa2, type: 2}
  nextSceneName: 
