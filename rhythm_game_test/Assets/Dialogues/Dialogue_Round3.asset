  m_Script: {fileID: 11500000, guid: fbb4f5274509a3f4d972369981413e90, type: 3}
  m_Name: Dialogue_Round3
  m_EditorClassIdentifier: 
  chapterTitle: "\uC81C 3\uC7A5"
  backgroundSprite: {fileID: 21300000, guid: 550e5cde59e52de4c80f0ea588784074, type: 3}
  leftCharacterDefault: {fileID: -1716309329, guid: 608455c0a88d71e418d0f31070c6c486, type: 3}
  rightCharacterDefault: {fileID: 1781293011, guid: 30e4f4bd85361c342ad83dced012e314, type: 3}
  lines:
  - speakerName: "\uB77C\uD5A5"
    speakerSprite: {fileID: 0}
    dialogue: "\uC5EC\uAE30\uAE4C\uC9C0 \uC62C\uB77C\uC624\uB2E4\uB2C8\u2026\r\n\uC0DD\uAC01\uBCF4\uB2E4
      \uD6E8\uC52C \uBA4B\uC9C4 \uAC78 \uBCF4\uC5EC\uC92C\uB124."
    isLeftSpeaker: 0
    effectSprites: []
  - speakerName: "\uC18C\uCC44"
    speakerSprite: {fileID: 0}
    dialogue: "\uACE0\uB9D9\uC2B5\uB2C8\uB2E4! \uC774\uC81C \uB77C\uD5A5 \uC120\uBC30\uB2D8\uACFC
      \uC694\uB9AC\uD55C\uB2E4\uB2C8 \uB354 \uD798\uC774 \uB098\uC694!"
    isLeftSpeaker: 1
    effectSprites: []
  - speakerName: "\uB77C\uD5A5"
    speakerSprite: {fileID: 0}
    dialogue: "\uADF8 \uC5F4\uC815\u2026 \uCC38 \uACF1\uB2E4.\r\n\uBD80\uB7EC\uC9C8\uAE4C
      \uAC71\uC815\uB420 \uB9CC\uD07C."
    isLeftSpeaker: 0
    effectSprites:
    - {fileID: 11400000, guid: 863eda03bcfe4414c9da11764b0ac7ca, type: 2}
    - {fileID: 11400000, guid: a2d282cf27bc82946842d6bc41138922, type: 2}
  - speakerName: "\uC18C\uCC44"
    speakerSprite: {fileID: 0}
    dialogue: "\uBD80\uB7EC\uC9C0\uC9C0 \uC54A\uC744 \uAC70\uC608\uC694. \uB354 \uB2E8\uB2E8\uD574\uC9C0\uACE0
      \uC788\uC73C\uB2C8\uAE4C\uC694!"
    isLeftSpeaker: 1
    effectSprites:
    - {fileID: 11400000, guid: baf6333a53ef57c468b3b12048edf193, type: 2}
  - speakerName: "\uB77C\uD5A5"
    speakerSprite: {fileID: 0}
    dialogue: "\uC88B\uC544. \uADF8\uB7F0 \uB9C8\uC74C\u2026 \uB098\uB294 \uBB34\uCC99
      \uC88B\uC544\uD574"
    isLeftSpeaker: 0
    effectSprites:
    - {fileID: 11400000, guid: 10ee16e5a3637a6499b8eb257e8a1173, type: 2}
  - speakerName: "\uB77C\uD5A5"
    speakerSprite: {fileID: 0}
    dialogue: "\uC624\uD5A5\uC7A5\uC721\uC740 \uD5A5\uC774 \uAE4A\uC5B4. \uC12C\uC138\uD558\uC9C0\uB9CC
      \uBB34\uAC81\uACE0, \uBD80\uB4DC\uB7FD\uC9C0\uB9CC \uB05D\uC744 \uBCF4\uBA74
      \uC544\uC8FC \uAC70\uCE60\uC9C0."
    isLeftSpeaker: 0
    effectSprites:
    - {fileID: 11400000, guid: 41ce25c9053dfce4a86a93cff484fbc9, type: 2}
  - speakerName: "\uC18C\uCC44"
    speakerSprite: {fileID: 0}
    dialogue: "\uADF8\uB798\uC11C \uB354 \uD574\uBCF4\uACE0 \uC2F6\uC5B4\uC694. \uC624\uB298
      \uAF2D \uC120\uBC30\uB2D8\uAED8 \uBCF4\uC5EC\uB4DC\uB9AC\uACE0 \uC2F6\uC5B4\uC694!"
    isLeftSpeaker: 1
    effectSprites:
    - {fileID: 11400000, guid: 35d33e6c035d2134a8afaf8fb186450f, type: 2}
  - speakerName: "\uB77C\uD5A5"
    speakerSprite: {fileID: 0}
    dialogue: "\uADF8 \uC5F4\uC815\uC774 \uC5BC\uB9C8\uB098 \uC624\uB798 \uBE5B\uB0A0\uAE4C\u2026\r\n\uAD81\uAE08\uD574\uC9C0\uB294\uAD70."
    isLeftSpeaker: 0
    effectSprites:
    - {fileID: 11400000, guid: 863eda03bcfe4414c9da11764b0ac7ca, type: 2}
    - {fileID: 11400000, guid: 6f34b8e7a44ad444e937d41dc305f9d9, type: 2}
  - speakerName: "\uB77C\uD5A5"
    speakerSprite: {fileID: 0}
    dialogue: "\uC88B\uC544.\r\n\uB124 \uB9DB\uC774 \uC5B4\uB290 \uC21C\uAC04 \uBB34\uB108\uC9C0\uB294\uC9C0,\r\n\uD639\uC740\u2026
      \uB05D\uAE4C\uC9C0 \uC0B4\uC544\uB0A8\uB294\uC9C0.\r\n\uC9C0\uCF1C\uBCFC\uAC8C."
    isLeftSpeaker: 0
    effectSprites:
    - {fileID: 11400000, guid: 863eda03bcfe4414c9da11764b0ac7ca, type: 2}
    - {fileID: 11400000, guid: 68af779b2ff60fa45a7e8d99dcb44919, type: 2}
  - speakerName: "\uC18C\uCC44"
    speakerSprite: {fileID: 0}
    dialogue: "\uB05D\uAE4C\uC9C0 \uC81C\uB300\uB85C \uB9CC\uB4E4\uACE0 \uC2F6\uC5B4\uC694.\r\n\uC81C\uAC00
      \uC9C0\uD0A4\uACE0 \uC2F6\uC740 \uB9DB\uC774 \uC788\uC73C\uB2C8\uAE4C\uC694."
    isLeftSpeaker: 1
    effectSprites:
    - {fileID: 11400000, guid: e9ec13dd2c5b3be4fb1495d399d9afa2, type: 2}
  - speakerName: "\uB77C\uD5A5"
    speakerSprite: {fileID: 0}
    dialogue: "\uADF8 \uC790\uC138\u2026 \uB9E4\uC6B0 \uC544\uB984\uB2F5\uB124. \uC790,
      \uBCF4\uC5EC\uC918. \uC5BC\uB9C8\uB098 \uACAC\uB51C \uC218 \uC788\uB294\uC9C0."
    isLeftSpeaker: 0
    effectSprites:
    - {fileID: 11400000, guid: 863eda03bcfe4414c9da11764b0ac7ca, type: 2}
  nextSceneName: 
