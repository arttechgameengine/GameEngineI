  m_Name: Dialogue_Round5
  m_EditorClassIdentifier: 
  chapterTitle: "\uCD5C\uC885\uC7A5"
  backgroundSprite: {fileID: 21300000, guid: 550e5cde59e52de4c80f0ea588784074, type: 3}
  leftCharacterDefault: {fileID: -1716309329, guid: 608455c0a88d71e418d0f31070c6c486, type: 3}
  rightCharacterDefault: {fileID: 1175334099, guid: 67d3e22cb44117044b721baa07cf76c1, type: 3}
  lines:
  - speakerName: "\uBD88\uB3C4\uD669"
    speakerSprite: {fileID: 0}
    dialogue: "\uB3C4\uB2EC\uD55C \uAC83\uB9CC\uC73C\uB85C \uB9CC\uC871\uD558\uB294
      \uD45C\uC815\uC774\uAD70."
    isLeftSpeaker: 0
    effectSprites: []
  - speakerName: "\uC18C\uCC44"
    speakerSprite: {fileID: 0}
    dialogue: "\uB9CC\uC871\uC774 \uC544\uB2C8\uB77C\u2026 \uAE30\uC058\uACE0, \uB5A8\uB9AC\uACE0,
      \uB354 \uD574\uBCF4\uACE0 \uC2F6\uC5B4\uC11C\u2014"
    isLeftSpeaker: 1
    effectSprites:
    - {fileID: 11400000, guid: 35d33e6c035d2134a8afaf8fb186450f, type: 2}
  - speakerName: "\uBD88\uB3C4\uD669"
    speakerSprite: {fileID: 0}
    dialogue: "\uAE30\uC068\uC740 \uC57D\uC790\uC758 \uAC10\uC815\uC774\uB2E4."
    isLeftSpeaker: 0
    effectSprites:
    - {fileID: 11400000, guid: 9e174229a3d2be64e828daa88285adf4, type: 2}
  - speakerName: "\uBD88\uB3C4\uD669"
    speakerSprite: {fileID: 0}
    dialogue: "\uC5EC\uAE30\uAE4C\uC9C0 \uC62C\uB77C\uC628 \uAC83.\r\n\uADF8 \uC0AC\uC2E4\uB9CC\uC73C\uB85C\uB294
      \uC544\uBB34 \uC758\uBBF8\uB3C4 \uC5C6\uB2E4.\r\n\uC815\uC0C1\uC740 \uADF8\uC800
      \uB3C4\uC804\uBC1B\uB294 \uC790\uB9AC\uAC00 \uC544\uB2C8\uB2E4.\r\n\uC9C0\uBC30\uC790\uAC00
      \uC11C\uB294 \uC790\uB9AC\uB2E4."
    isLeftSpeaker: 0
    effectSprites:
    - {fileID: 11400000, guid: 9e174229a3d2be64e828daa88285adf4, type: 2}
  - speakerName: "\uC18C\uCC44"
    speakerSprite: {fileID: 0}
    dialogue: "\uADF8\uB798\uB3C4 \uC800\uB294 \uC81C \uB9DB\uC73C\uB85C\u2014"
    isLeftSpeaker: 1
    effectSprites:
    - {fileID: 11400000, guid: a652034c7126d254fb8c1613a3df90d3, type: 2}
    - {fileID: 11400000, guid: 9dd834cb0e9ec4b4a94b40c7ce369e99, type: 2}
  - speakerName: "\uBD88\uB3C4\uD669"
    speakerSprite: {fileID: 0}
    dialogue: "\uB108\uC758 \uB9DB\uC740 \uACB0\uC2B9\uC5D0\uC11C \uD3C9\uAC00\uBC1B\uC744
      \uC218\uC900\uC774 \uC544\uB2C8\uB2E4"
    isLeftSpeaker: 0
    effectSprites:
    - {fileID: 11400000, guid: 9e174229a3d2be64e828daa88285adf4, type: 2}
  - speakerName: "\uBD88\uB3C4\uD669"
    speakerSprite: {fileID: 0}
    dialogue: "\uC804 \uB77C\uC6B4\uB4DC\uC5D0\uC11C \uB124\uAC00 \uC5B4\uB5BB\uAC8C
      \uC62C\uB77C\uC654\uB294\uC9C0,\r\n\uC5B4\uB5A4 \uAC10\uC815\uC744 \uD488\uC5C8\uB294\uC9C0\u2026\r\n\uBAA8\uB450
      \uD558\uCC2E\uB2E4."
    isLeftSpeaker: 0
    effectSprites:
    - {fileID: 11400000, guid: 41d8a78b552448649bccad8d5155c29b, type: 2}
  - speakerName: "\uBD88\uB3C4\uD669"
    speakerSprite: {fileID: 0}
    dialogue: "\uBD88\uB3C4\uC7A5\uC740 \uC2E4\uB825\uC758 \uC815\uC218\uB2E4.\r\n\uD754\uB4E4\uB9AC\uB294
      \uB9C8\uC74C, \uB728\uAC70\uC6B4 \uAC10\uC815,\r\n\uADF8 \uB530\uC704\uB294\u2014\uBD88
      \uC544\uB798\uC11C \uAC00\uC7A5 \uBA3C\uC800 \uD0C0\uBC84\uB9B0\uB2E4."
    isLeftSpeaker: 0
    effectSprites:
    - {fileID: 11400000, guid: 18359c545bcf7224080d2cede3a78ae7, type: 2}
  - speakerName: "\uC18C\uCC44"
    speakerSprite: {fileID: 0}
    dialogue: "\uADF8\uB7FC\u2026 \uC81C \uBD88\uC774 \uC5BC\uB9C8\uB098 \uAC00\uB294\uC9C0
      \uC9C1\uC811 \uBCF4\uC5EC\uB4DC\uB9B4\uAC8C\uC694."
    isLeftSpeaker: 1
    effectSprites:
    - {fileID: 11400000, guid: e9ec13dd2c5b3be4fb1495d399d9afa2, type: 2}
  - speakerName: "\uBD88\uB3C4\uD669"
    speakerSprite: {fileID: 0}
    dialogue: "\uC88B\uB2E4.\r\n\uC655\uC88C \uC55E\uC5D0 \uC130\uC73C\uB2C8\u2014\r\n\uD310\uACB0\uC744
      \uB0B4\uB824\uC8FC\uC9C0."
    isLeftSpeaker: 0
    effectSprites:
    - {fileID: 11400000, guid: 2f5accc72d1636b429c55db9a2287c3e, type: 2}
  - speakerName: "\uBD88\uB3C4\uD669"
    speakerSprite: {fileID: 0}
    dialogue: "\uB108\uC758 \uC5F4\uC815\uC740 \uBD88\uB3C4\uC7A5 \uC55E\uC5D0\uC11C
      \uAEBC\uC9C4\uB2E4.\r\n\uB108\uC758 \uC131\uC7A5\uC740 \uB098\uC758 \uACA9\uC5D0
      \uB2FF\uC9C0 \uBABB\uD55C\uB2E4."
    isLeftSpeaker: 0
    effectSprites:
    - {fileID: 11400000, guid: 18359c545bcf7224080d2cede3a78ae7, type: 2}
  - speakerName: "\uBD88\uB3C4\uD669"
    speakerSprite: {fileID: 0}
    dialogue: "\uADF8\uB9AC\uACE0 \uB108\uC758 \uB3C4\uC804\uC740\u2014\n\uC624\uB298\uB85C
      \uB05D\uB09C\uB2E4"
    isLeftSpeaker: 0
    effectSprites:
    - {fileID: 11400000, guid: 18359c545bcf7224080d2cede3a78ae7, type: 2}
    - {fileID: 11400000, guid: 9e174229a3d2be64e828daa88285adf4, type: 2}
  nextSceneName: 
